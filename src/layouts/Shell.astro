---
import fs from 'node:fs';
import { site, music, socialLinks } from '../lib/content.js';
import '../styles/global.css';
const { title, description = site.description, canonical = Astro.url.pathname } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
// Render the existing player unchanged, replacing only its Jekyll data binding.
const player = fs.readFileSync('_includes/music-player.html', 'utf8')
  .replace(/\{%-?\s*assign music_tracks = site.data.music\s*-?%\}/, '')
  .replace(/\{%\s*if music_tracks and music_tracks.size > 0\s*%\}/, '')
  .replace(/\{%\s*endif\s*%\}/, '')
  .replace('{{ music_tracks | jsonify }}', JSON.stringify(music).replace(/</g, '\\u003c'));
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101210" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(canonical, site.url)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(canonical, site.url)} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/feed.xml" />
  </head>
  <body>
    <a href="#swup" class="skip-link">跳到正文</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label={site.title + '，首页'}>veihi<span class="wordmark-dot">.</span><span class="wordmark-sub">独立数字档案</span></a>
      <nav aria-label="主导航"><a href="/#archive">文章档案<span>01</span></a><a href="/#about">关于这里<span>02</span></a><a class="nav-contact" data-contact-email href={`mailto:${site.email}`}>聊聊合作 <i aria-hidden="true">↗</i></a></nav>
    </header>
    <main id="swup"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><a href="/" class="footer-wordmark">veihi<span>.</span></a><p>保持好奇。持续记录。<br /><span>THANKS FOR STOPPING BY.</span></p><a class="back-top" href="#top" aria-label="回到顶部">↑</a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.title}</span><div>{socialLinks.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}<a data-contact-email data-contact-display href={`mailto:${site.email}`}>{site.email}</a></div><span>独立构建 · 持续更新</span></div>
    </footer>
    <Fragment set:html={player} />
    <script id="site-contact" type="application/json" set:html={JSON.stringify({ email: site.email }).replace(/</g, '\\u003c')} />
    <script>import '../scripts/navigation.js'; import '../scripts/experience.js';</script>
  </body>
</html>
